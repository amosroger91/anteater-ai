{
  "name": "anteater-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx apps/orchestrator/demo.ts",
    "worker": "tsx apps/orchestrator/worker.ts",
    "research": "tsx apps/orchestrator/worker.ts --research",
    "test:browser": "tsx --test tests/browser/*.test.ts",
    "models:inspect": "tsx scripts/models.ts",
    "models:setup": "tsx scripts/model-setup.ts",
    "models:advise": "tsx scripts/model-setup.ts advise",
    "ollama:install": "tsx scripts/model-setup.ts install-ollama",
    "ollama:pull": "tsx scripts/model-setup.ts pull",
    "posture:check": "tsx scripts/posture-check.ts",
    "posture:scan": "tsx scripts/posture-scan.ts",
    "coverage:report": "tsx scripts/coverage.ts",
    "gate": "tsx scripts/gate.ts",
    "eval:model": "tsx scripts/eval-model.ts",
    "intake:h1": "tsx scripts/intake-hackerone.ts",
    "auto": "tsx scripts/auto.ts",
    "campaign": "tsx scripts/campaign.ts",
    "monitor": "tsx scripts/monitor.ts",
    "aggressive": "tsx scripts/aggressive.ts",
    "retention:sweep": "tsx scripts/retention-sweep.ts",
    "finding:submit": "tsx scripts/submit-finding.ts",
    "triage": "tsx scripts/triage.ts",
    "fleet": "tsx scripts/fleet.ts",
    "metrics": "tsx scripts/metrics.ts",
    "ledger": "tsx scripts/ledger.ts",
    "preflight": "tsx scripts/preflight.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "bounty:fetch": "tsx scripts/bounty-inbox.ts fetch",
    "bounty:refresh": "tsx scripts/bounty-inbox.ts refresh",
    "bounty:review": "tsx scripts/bounty-inbox.ts review",
    "bounty:promote": "tsx scripts/bounty-inbox.ts promote",
    "bounty:list": "tsx scripts/bounty-inbox.ts list",
    "check": "npm run build && npm test",
    "verify:local": "tsx scripts/verify-local.ts",
    "deps:list": "tsx scripts/dependencies.ts list",
    "deps:check": "tsx scripts/dependencies.ts check",
    "deps:sync": "tsx scripts/dependencies.ts sync"
  },
  "dependencies": {
    "imapflow": "2.2.1",
    "pg": "^8.16.3",
    "playwright": "1.63.0",
    "postal-mime": "4.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
