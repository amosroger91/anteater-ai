{
  "name": "anteater-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo": "tsx apps/orchestrator/demo.ts",
    "models:inspect": "tsx scripts/models.ts",
    "check": "npm run build && npm test",
    "verify:local": "tsx scripts/verify-local.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
