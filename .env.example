# Local development only; supply DATABASE_URL to Node through your shell.
DATABASE_URL=postgresql://anteater:local-fixture-only@127.0.0.1:55432/anteater
GLOBAL_KILL_SWITCH=true
REQUIRE_SCOPE=true
REQUIRE_PROGRAM_POLICY=true
ALLOW_ACTIVE_TESTING=false
ENABLE_PASSIVE_HTTP=false
ENABLE_APPLICATION_RESEARCH=false
# Required only for generated application-test accounts; provide a dedicated 32-byte key via the secret manager.
# ACCOUNT_KEY=<64-hex-character-secret>
# Optional key for sealing redacted replay evidence. Unset leaves the redacted JSON unsealed.
# EVIDENCE_KEY=<64-hex-character-secret>
CREDENTIAL_STORE=secrets/accounts
PROGRAM_SOURCE=fixture
# PROGRAMS_FILE=reviewed-programs.json
MAX_RESPONSE_BYTES=65536
MAX_CONCURRENT_JOBS=1
MAX_REQUEST_RATE=1
JOB_LEASE_SECONDS=30
PROGRAMS_DIR=programs
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
LLM_PROVIDER=fixture
# Record the digest from `ollama show <model>` before enabling a real model worker.
# OLLAMA_MODEL_DIGEST=sha256:...
